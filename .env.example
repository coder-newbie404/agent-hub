# agent-hub configuration SAMPLE. Compose auto-loads a file named .env from
# this directory; use any existing env file by saving it as .env. Only
# ADMIN_TOKEN is required for the default stack.

# ---- hub (default stack) -------------------------------------------------
# Bootstrap admin token: admin REST, /ws/ui, and a wildcard agent WebSocket.
# The Discord bot uses it as its hub token (HUB_TOKEN), so it stays in
# place; it is not meant to be revoked. Agents and adapters should use
# per-agent tokens instead (POST /tokens or Discord /agent token new).
# REQUIRED: any long random string. compose refuses to start without it.
# Full admin over the hub, so keep it secret.
ADMIN_TOKEN=
# SQLite location inside the manager container (compose provides /data).
SQLITE_PATH=/data/manager.db

# ---- TLS termination (--profile caddy) ------------------------------------
# A DNS name -> automatic Let's Encrypt (ports 80+443 must be reachable).
# A bare IP or "localhost" -> Caddy issues a self-signed cert from its
# internal CA; adapter machines must trust it (see docs/DEPLOY.md).
# Optional: if unset, compose defaults to "localhost" (an empty value would
# make Caddy start with no usable site address, so it is never left empty).
DOMAIN=localhost

# ---- Discord frontend (--profile discord) ---------------------------------
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=0
DISCORD_GUILD_ID=
DISCORD_SYNC_CHANNEL_ID=
# In-network alias; override only if you renamed the manager service.
# HUB_URL=http://manager:8000

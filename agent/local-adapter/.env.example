# agent/local-adapter/.env — local adapter configuration (systemd reads this
# file via EnvironmentFile; keep it out of git).

# Hub connectivity (outbound WebSocket).
# <your-host> = your hub's DNS name or IP (see docs/DEPLOY.md for TLS modes)
MANAGER_URL=wss://<your-host>/ws/agent
# localhost (hub from the root compose.yml, no TLS): ws://127.0.0.1:8000/ws/agent
# Per-agent bearer token: mint via POST /tokens or Discord /agent token new
AGENT_TOKEN=mint-via-POST-/tokens-or-Discord-/agent-token-new
# Workspace the adapter passes to omp when a session has none
DEFAULT_WORKSPACE=<dir omp may work in>

# The LLM key for local runs is NOT read here: omp uses its own auth store
# (~/.local/share/opencode/auth.json). One key per agent.

# Optional: component tuning file (defaults shown; see config/adapter.config.toml)
# ADAPTER_CONFIG=config/adapter.config.toml

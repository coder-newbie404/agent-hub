# Adapter configuration for ONE instance (one runtime). Copy this file to
# agent/local-adapter/.env for a manual run, or to
# ~/.config/agent-adapter/<instance>.env for the systemd template unit
# (agent-adapter@<instance>). Keep it out of git and `chmod 600` it.

# Hub connectivity (outbound WebSocket).
# <your-host> = your hub's DNS name or IP (see docs/DEPLOY.md for TLS modes)
MANAGER_URL=wss://<your-host>/ws/agent
# localhost (hub from the root compose.yml, no TLS): ws://127.0.0.1:8000/ws/agent
# Per-agent bearer token: mint via POST /tokens or Discord /agent token new
AGENT_TOKEN=mint-via-POST-/tokens-or-Discord-/agent-token-new
# Workspace the adapter passes to the runtime when a session has none
DEFAULT_WORKSPACE=<dir the agent may work in>

# Which agent runtime this instance drives (required): omp | claude | opencode.
# Do not put inline comments after a value: systemd's EnvironmentFile would
# keep them as part of the value.
RUNTIME=omp

# Binary to run. Default: the runtime name, resolved on PATH.
# systemd's PATH usually lacks ~/.local/bin: set an absolute path there.
# RUNTIME_BIN=/absolute/path/to/binary

# What the agent may do unattended: default | readonly | edits | full.
# Support differs per runtime: see README.
# POLICY=default

# Model to use. Unset = the runtime's own configured default. opencode's
# configured default model may be missing on your machine: set MODEL=provider/model.
# MODEL=

# Identity registered with the hub. Every instance needs its own id and token.
# AGENT_ID=<runtime>-local

# Extra env var NAME patterns the agent process may see, on top of the built-in
# allow-list (see README). JSON list; fnmatch patterns.
# ENV_PASSTHROUGH=["GOOGLE_CLOUD_PROJECT"]

# Recommended: confine workspaces to this directory tree.
# ALLOWED_ROOT=

# Component tuning file (defaults shown; see config/adapter.config.toml)
# ADAPTER_CONFIG=config/adapter.config.toml

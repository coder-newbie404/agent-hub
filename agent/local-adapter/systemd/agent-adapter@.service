[Unit]
Description=agent-hub adapter (%i)
After=network-online.target

[Service]
Type=simple
# Edit the two /opt/agent-hub paths to wherever you cloned agent-hub.
WorkingDirectory=/opt/agent-hub/agent/local-adapter
# One env file per instance: ~/.config/agent-adapter/<instance>.env
EnvironmentFile=%h/.config/agent-adapter/%i.env
ExecStart=/opt/agent-hub/agent/local-adapter/.venv/bin/python -m agent_adapter
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
